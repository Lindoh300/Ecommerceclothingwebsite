# Copy this file to .env and fill in the values. Vite reads .env at build and dev time.
# Do not put service role keys here. Anything prefixed VITE_ is shipped to the browser.

# Supabase Project URL, for example https://<project-ref>.supabase.co
# Dashboard: Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose in the browser.
# Dashboard: Project Settings -> API -> Project API keys -> anon public
VITE_SUPABASE_ANON_KEY=

# Optional. Overrides the API base URL the frontend calls.
# Leave empty to use ${VITE_SUPABASE_URL}/functions/v1/make-server-fbb8f0e1.
# For local development without a Supabase project, set it to:
#   http://localhost:8787/make-server-fbb8f0e1
# See docs/SUPABASE_SETUP.md, "Local development without a project".
VITE_API_BASE=

# Optional. The gallery theme is the default. Set VITE_THEME=plain for the plain look.
# Read at build time.
VITE_THEME=
